flowchart LR
%% 说明：大框架不变，仅在子图标题和补充说明处增加中文注释，补充扩展跨服务接口
  UI[前端 / 浏览器]

  subgraph SVC["业务微服务（3 个：均独立构建、测试、部署）"]
    US["user-service<br/>职责：注册/登录/个人资料<br/>角色权限/用户管理<br/>站内通知/操作日志"]
    LS["learning-service<br/>职责：课程/班级/选退课<br/>教学资源/学习进度/笔记<br/>讨论帖/回复/AI答疑<br/>总结/思维导图/图片讲解"]
    AS["assessment-service<br/>职责：作业/考试/编程题<br/>学生提交/教师批改<br/>成绩统计/编程判题<br/>（Judge0 + 本地判题）"]
    SVC_NOTE["说明：跨服务只通过 /internal/** 接口调用；禁止跨服务直读数据库或联表查询"]:::note
  end

  subgraph DBS["数据库（各服务独占）"]
    DB1[(user_db<br/>user, notification, operation_log)]
    DB2[(learning_db<br/>course, course_class, course_enrollment<br/>resource, resource_progress, study_note<br/>discussion_post, discussion_reply)]
    DB3[(assessment_db<br/>task, submission, exam_record)]
    DB_NOTE["每个服务只能读写自己的库，其他服务不可直接访问"]:::note
  end

  UI --> US
  UI --> LS
  UI --> AS

  LS -- "GET /internal/users/{id}" --> US
  LS -- "GET /internal/users/by-ids?ids=..." --> US
  LS -- "GET /internal/users?role=student" --> US
  LS -- "POST /internal/notifications" --> US
  LS -- "POST /internal/notifications/batch" --> US
  LS -- "POST /internal/operation-logs" --> US

  AS -- "GET /internal/users/{id}" --> US
  AS -- "GET /internal/users/by-ids?ids=..." --> US
  AS -- "POST /internal/notifications" --> US
  AS -- "POST /internal/operation-logs" --> US

  AS -- "GET /internal/courses/{id}" --> LS
  AS -- "GET /internal/courses/{id}/access?userId=..." --> LS
  AS -- "GET /internal/courses/{id}/authorization?userId=...&action=..." --> LS
  AS -- "GET /internal/enrollments/check?studentId=...&courseId=..." --> LS
  AS -- "GET /internal/enrollments/student/{studentId}" --> LS
  AS -- "GET /internal/enrollments/course/{courseId}" --> LS

  LS -- "GET /internal/tasks/{id}" --> AS
  LS -- "GET /internal/tasks?courseId=..." --> AS
  LS -- "GET /internal/scores/student/{studentId}" --> AS
  LS -- "GET /internal/scores/course/{courseId}" --> AS

  US --> DB1
  LS --> DB2
  AS --> DB3

  classDef note fill:#fffbe6,stroke:#e6c200,stroke-dasharray:4 4,color:#333,font-size:12px;