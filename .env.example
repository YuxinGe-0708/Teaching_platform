MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=teaching_platform
MYSQL_USER=tp_dev
MYSQL_PASSWORD=123456
MYSQL_PORT=3306
TZ=Asia/Shanghai

# Frontend/backend container ports
FRONTEND_PORT=3000
BACKEND_PORT=8081
IMAGE_TAG=dev

# Optional registry mirrors for networks that cannot reach Docker Hub directly.
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0.43
MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.8.8-eclipse-temurin-8
JAVA_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:8-jdk-jammy
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# Optional backend settings. Leave AI keys blank unless the AI feature is being tested.
APP_SEED_TEST_DATA=false
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_API_KEY=
AI_MODEL=qwen-plus
AI_VISION_MODEL=qwen3-vl-plus
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_TIMEOUT_MS=15000
JUDGE0_LOCAL_FALLBACK=true
